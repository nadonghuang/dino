Output demo.gif
Set FontSize 18
Set Width 1200
Set Height 600
Set Padding 15
Set Theme { "background": "#1a1b26", "foreground": "#a9b1d6" }

Hide
Type "cd /tmp && cp -r '/Volumes/Harvey/github创意/dino' . && cd dino && clear"
Enter
Sleep 500ms

Type "python3 dino.py"
Enter
Sleep 2s
Show

Type "SPACE to start!"
Sleep 500ms

Space
Sleep 2s

# Jump sequence - timed to dodge obstacles
Space
Sleep 1.2s

Space
Sleep 0.9s

Space
Sleep 1.5s

# Duck under pterodactyls
Down
Sleep 1s

# More action
Space
Sleep 0.7s

Space
Sleep 1s

Space
Sleep 1.3s

Space
Sleep 0.8s

Space
Sleep 2s

# Let it run to build score
Sleep 4s

Space
Sleep 1s

Space
Sleep 1.5s

# Game over moment
Sleep 3s

# Show game over screen
Sleep 2s

Escape
